# Эталонные векторы: реальный обмен с прибором.
#
# Прибор:   FBG-Interrogator GC-97001C-03-01-A-F, SN 94401220, прошивка 4.10
# Источник: KB_02_protocol.md, раздел «Эталонные векторы с реального прибора»
# Статус:   ✅ проверено на приборе — пять ответов сняты с железа
#
# Формат файла: «имя = байты в hex». Строка, начинающаяся с #, — комментарий.

# --- Запросы чтения (ID = 0x10). LEN = 4 = полная длина кадра ---
req_version                = 10 01 04 00
req_serial                 = 10 03 04 00
req_module_params          = 10 04 04 00
req_sweep                  = 10 05 04 00
req_channel_setup          = 10 06 04 00

# --- Ответы прибора ✅. Поле LEN — 2 байта, равно полной длине кадра ---

# версия = 0x0000019A = 410 → v4.10
resp_version               = 10 01 00 08 00 00 01 9A

# SN = 0x05A072C4 = 94401220
resp_serial                = 10 03 00 08 05 A0 72 C4

# скорость 0x00CA = 202 → 2000 Гц · каналов 4 · решёток 30 · интервал пиков 30 ГГц
resp_module_params         = 10 04 00 0C 00 CA 00 04 00 1E 00 1E

# Start=1 (196250 ГГц) · Step=2 · Stop=5101 (191150 ГГц) · ADCStep=2
resp_sweep                 = 10 05 00 0C 00 01 00 02 13 ED 00 02

# 4 канала × (порог FFFF = авто, усиление 00 05 = авто, уровень 5)
resp_channel_setup         = 10 06 00 14 FF FF 00 05 FF FF 00 05 FF FF 00 05 FF FF 00 05

# --- Команды записи (ID = 0x20). Статус 🟡: сняты из PDF, на приборе не проверены ---
#
# Кадр развёртки — предмет открытого вопроса D3: LEN здесь 0x0C = 12,
# а самих байт 11. Это ошибка №3 в списке ошибок документации (KB_01).
# Профиль (set_sweep_frame_len=11, set_sweep_len_field=12) воспроизводит
# строку буквально; профиль по умолчанию (12, None) даёт самосогласованный
# кадр в 12 байт с тем же LEN.
cmd_set_sweep_pdf          = 20 01 0C 00 01 00 02 13 ED 00 02
cmd_set_threshold_ch3_1200 = 20 02 06 02 04 B0
cmd_set_threshold_ch3_auto = 20 02 06 02 FF FF
cmd_set_gain_ch4_manual2   = 20 03 06 03 80 02
cmd_set_gain_ch4_auto      = 20 03 06 03 00 00
cmd_set_peak_gap_30        = 20 04 04 1E
cmd_set_peak_gap_40        = 20 04 04 28
cmd_save_thresholds        = 20 06 04 00

# --- Ответы на команды записи ---
ack_write_ok               = 20 02 00 06 00 01
ack_write_fail             = 20 02 00 06 00 00

# --- Режимы работы (ID = 0x30). Поле LEN в ответах — 4 байта 🟡 ---
cmd_stop                   = 30 01 06 00 00 00
cmd_start_stream_current   = 30 02 06 00 00 00
cmd_debug_once             = 30 03 06 00 00 00
cmd_read_raw_adc_ch1       = 30 07 06 00 00 00

# LEN = 0x00000008 = 8 = полная длина кадра, статус 0x0001 = успех
resp_stop_ack              = 30 01 00 00 00 08 00 01
